# The condition is matched against the whole request uri, so it needs a leading .*
# Static files stay themselves. Client routes such as /discussions load the app.
RewriteCond %{REQUEST_URI} .+\.(css|js|svg|png|jpg|jpeg|gif|webp|ico|html|map|txt|json)$ [NC]
RewriteRule .* - [L]
RewriteRule .* /index.html [L]
